package com.voidforge.enderkatana.registry;

import com.voidforge.enderkatana.EnderKatana;
import net.minecraft.core.registries.Registries;
import net.minecraft.network.chat.Component;
import net.minecraft.world.item.CreativeModeTab;
import net.minecraft.world.item.ItemStack;
import net.neoforged.neoforge.registries.DeferredRegister;
import java.util.function.Supplier;

public final class ModCreativeTabs {
    public static final DeferredRegister<CreativeModeTab> TABS = DeferredRegister.create(Registries.CREATIVE_MODE_TAB, EnderKatana.MOD_ID);
    public static final Supplier<CreativeModeTab> MAIN = TABS.register("main", () -> CreativeModeTab.builder()
            .title(Component.translatable("itemGroup.enderkatana.main"))
            .icon(() -> new ItemStack(ModItems.ENDER_KATANA.get()))
            .displayItems((parameters, output) -> {
                output.accept(ModItems.ENDER_KATANA.get());
                output.accept(ModItems.ABSOLUTE_KATANA.get());
                output.accept(ModItems.VOID_SHARD.get());
                output.accept(ModItems.DRAGON_CORE.get());
                output.accept(ModItems.END_CITY_RELIC.get());
            }).build());

    private ModCreativeTabs() {}
}
