package com.voidforge.enderkatana.ability;

import com.voidforge.enderkatana.EnderKatana;
import com.voidforge.enderkatana.config.KatanaConfig;
import com.voidforge.enderkatana.registry.ModItems;
import net.minecraft.server.level.ServerPlayer;
import net.minecraft.world.entity.EntityType;
import net.minecraft.world.entity.item.ItemEntity;
import net.minecraft.world.entity.boss.enderdragon.EnderDragon;
import net.minecraft.world.entity.player.Player;
import net.minecraft.world.item.ItemStack;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.world.entity.EquipmentSlotGroup;
import net.minecraft.world.entity.ai.attributes.AttributeModifier;
import net.minecraft.world.entity.ai.attributes.Attributes;
import net.neoforged.neoforge.event.ItemAttributeModifierEvent;
import net.neoforged.bus.api.SubscribeEvent;
import net.neoforged.fml.common.EventBusSubscriber;
import net.neoforged.neoforge.event.entity.living.LivingDeathEvent;
import net.neoforged.neoforge.event.entity.living.LivingDropsEvent;
import net.neoforged.neoforge.event.entity.player.PlayerEvent;
import net.neoforged.neoforge.event.tick.PlayerTickEvent;

@EventBusSubscriber(modid = EnderKatana.MOD_ID)
public final class KatanaEvents {
    @SubscribeEvent
    public static void modifyKatanaAttributes(ItemAttributeModifierEvent event) {
        ItemStack stack = event.getItemStack();
        boolean absolute = stack.is(ModItems.ABSOLUTE_KATANA.get());
        if (!absolute && !stack.is(ModItems.ENDER_KATANA.get())) return;
        event.removeAllModifiersFor(Attributes.ATTACK_DAMAGE);
        event.removeAllModifiersFor(Attributes.ATTACK_SPEED);
        double totalDamage = absolute ? KatanaConfig.ABSOLUTE_ATTACK_DAMAGE.get() : KatanaConfig.BASE_ATTACK_DAMAGE.get();
        double totalSpeed = absolute ? KatanaConfig.ABSOLUTE_ATTACK_SPEED.get() : KatanaConfig.BASE_ATTACK_SPEED.get();
        event.addModifier(Attributes.ATTACK_DAMAGE,
                new AttributeModifier(ResourceLocation.fromNamespaceAndPath(EnderKatana.MOD_ID, absolute ? "absolute_damage" : "katana_damage"), totalDamage - 1.0, AttributeModifier.Operation.ADD_VALUE),
                EquipmentSlotGroup.MAINHAND);
        event.addModifier(Attributes.ATTACK_SPEED,
                new AttributeModifier(ResourceLocation.fromNamespaceAndPath(EnderKatana.MOD_ID, absolute ? "absolute_speed" : "katana_speed"), totalSpeed - 4.0, AttributeModifier.Operation.ADD_VALUE),
                EquipmentSlotGroup.MAINHAND);
    }

    @SubscribeEvent
    public static void onPlayerTick(PlayerTickEvent.Post event) {
        if (event.getEntity() instanceof ServerPlayer player) {
            KatanaAbilityService.onPlayerTick(player);
        }
    }

    @SubscribeEvent
    public static void onLivingDeath(LivingDeathEvent event) {
        KatanaAbilityService.onLivingDeath(event.getEntity(), event.getSource());
    }

    @SubscribeEvent
    public static void onDragonDrops(LivingDropsEvent event) {
        if (!(event.getEntity() instanceof EnderDragon dragon) || dragon.level().isClientSide) return;
        ItemEntity drop = new ItemEntity(dragon.level(), dragon.getX(), dragon.getY() + 1.0, dragon.getZ(), new ItemStack(ModItems.DRAGON_CORE.get()));
        event.getDrops().add(drop);
    }

    @SubscribeEvent
    public static void onLogout(PlayerEvent.PlayerLoggedOutEvent event) {
        KatanaAbilityService.onLogout(event.getEntity());
    }

    private KatanaEvents() {}
}
