package com.voidforge.enderkatana.client;

import com.mojang.blaze3d.platform.InputConstants;
import com.voidforge.enderkatana.EnderKatana;
import com.voidforge.enderkatana.network.AbilityPayload;
import com.voidforge.enderkatana.network.KatanaClientSync;
import com.voidforge.enderkatana.registry.ModItems;
import net.minecraft.client.KeyMapping;
import net.minecraft.client.Minecraft;
import net.minecraft.client.gui.GuiGraphics;
import net.minecraft.network.chat.Component;
import net.minecraft.world.item.ItemStack;
import net.neoforged.api.distmarker.Dist;
import net.neoforged.fml.common.EventBusSubscriber;
import net.neoforged.neoforge.client.event.ClientTickEvent;
import net.neoforged.neoforge.client.event.RegisterKeyMappingsEvent;
import net.neoforged.neoforge.client.event.RenderGuiEvent;
import net.neoforged.neoforge.network.PacketDistributor;
import org.lwjgl.glfw.GLFW;

@EventBusSubscriber(modid = EnderKatana.MOD_ID, value = Dist.CLIENT, bus = EventBusSubscriber.Bus.MOD)
final class KatanaKeyRegistration {
    static final KeyMapping DASH = key("dash", GLFW.GLFW_KEY_R);
    static final KeyMapping SLASH = key("spatial_slash", GLFW.GLFW_KEY_V);
    static final KeyMapping MARK = key("mark_teleport", GLFW.GLFW_KEY_G);
    static final KeyMapping RETURN = key("return_point", GLFW.GLFW_KEY_H);
    static final KeyMapping ULTIMATE = key("dragon_wrath", GLFW.GLFW_KEY_B);
    static final KeyMapping EMPOWER = key("empower", GLFW.GLFW_KEY_C);

    private static KeyMapping key(String name, int key) {
        return new KeyMapping("key.enderkatana." + name, InputConstants.Type.KEYSYM, key, "key.categories.enderkatana");
    }

    @net.neoforged.bus.api.SubscribeEvent
    public static void register(RegisterKeyMappingsEvent event) {
        event.register(DASH);
        event.register(SLASH);
        event.register(MARK);
        event.register(RETURN);
        event.register(ULTIMATE);
        event.register(EMPOWER);
    }
}

@EventBusSubscriber(modid = EnderKatana.MOD_ID, value = Dist.CLIENT)
public final class KatanaClientEvents {
    @net.neoforged.bus.api.SubscribeEvent
    public static void clientTick(ClientTickEvent.Post event) {
        Minecraft mc = Minecraft.getInstance();
        if (mc.player == null || mc.level == null) return;
        sendIfPressed(KatanaKeyRegistration.DASH, 0);
        sendIfPressed(KatanaKeyRegistration.SLASH, 1);
        sendIfPressed(KatanaKeyRegistration.MARK, 2);
        sendIfPressed(KatanaKeyRegistration.RETURN, 3);
        sendIfPressed(KatanaKeyRegistration.ULTIMATE, 4);
        sendIfPressed(KatanaKeyRegistration.EMPOWER, 5);
    }

    private static void sendIfPressed(KeyMapping mapping, int ability) {
        while (mapping.consumeClick()) PacketDistributor.sendToServer(new AbilityPayload(ability));
    }

    @net.neoforged.bus.api.SubscribeEvent
    public static void renderHud(RenderGuiEvent.Post event) {
        Minecraft mc = Minecraft.getInstance();
        if (mc.player == null || mc.options.hideGui) return;
        ItemStack main = mc.player.getMainHandItem();
        ItemStack off = mc.player.getOffhandItem();
        boolean equipped = main.is(ModItems.ENDER_KATANA.get()) || main.is(ModItems.ABSOLUTE_KATANA.get())
                || off.is(ModItems.ENDER_KATANA.get()) || off.is(ModItems.ABSOLUTE_KATANA.get());
        if (!equipped) return;

        GuiGraphics gui = event.getGuiGraphics();
        int x = 10;
        int y = mc.getWindow().getGuiScaledHeight() - 50;
        gui.fill(x, y, x + 174, y + 42, 0xB8150B22);
        gui.fill(x, y, x + 174, y + 2, KatanaClientSync.absoluteForm ? 0xFFFF4DEB : 0xFF9C51FF);
        String title = KatanaClientSync.absoluteForm ? "ABSOLUTE VOID" : "ENDER KATANA";
        gui.drawString(mc.font, title, x + 7, y + 5, 0xFFF4DEFF, false);
        gui.drawString(mc.font, Component.translatable("hud.enderkatana.energy", KatanaClientSync.energy), x + 7, y + 17, 0xFFD9B5FF, false);
        int bx = x + 7, by = y + 30, bw = 160;
        gui.fill(bx, by, bx + bw, by + 6, 0xFF382843);
        int filled = (int) (bw * (KatanaClientSync.energy / 100.0));
        if (filled > 0) gui.fill(bx, by, bx + filled, by + 6, KatanaClientSync.absoluteForm ? 0xFFFF48E7 : 0xFF9D49FF);
        String mode = KatanaClientSync.empowered ? "VOID RHYTHM: ON" : "R Dash  V Rift  G Mark  H Return  B Ultimate  C Empower";
        gui.drawString(mc.font, mode, x + 7, y - 10, KatanaClientSync.empowered ? 0xFFFF70EF : 0xFFD6C5E8, false);
    }

    private KatanaClientEvents() {}
}
